{
  "name": "v3-h5-tpl",
  "version": "0.1.0",
  "private": true,
  "description": "Vue3 H5 mobile app base template",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vant": "^4.9.15",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@ithinku/oxfmt-config": "^0.1.2",
    "@ithinku/oxlint-config": "^0.1.0",
    "@ithinku/tsconfig": "^0.0.8",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "unplugin-vue-components": "^0.28.0",
    "vconsole": "^3.15.1",
    "vite": "^6.0.7",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
